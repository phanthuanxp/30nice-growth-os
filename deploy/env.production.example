# Production .env cho 30Nice Growth OS
# Copy file này sang .env và điền giá trị thật:
#   cp deploy/env.production.example .env
#   nano .env

# === DATABASE ===
# Lấy từ output của setup.sh (postgresql://growth_os:PASS@localhost:5432/growth_os_db)
DATABASE_URL="postgresql://growth_os:CHANGE_ME@localhost:5432/growth_os_db"

# === SESSION ===
# Tạo chuỗi ngẫu nhiên dài >= 32 ký tự:
#   openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_random_32_chars_min"

# === AI (Claude) ===
# Lấy tại console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# === CRON ===
# Tạo chuỗi ngẫu nhiên bất kỳ, dùng trong header x-cron-secret khi gọi cron endpoints
#   openssl rand -hex 20
CRON_SECRET="CHANGE_ME_cron_secret"

# === META / FACEBOOK PAGE PUBLISHING ===
# Không commit giá trị thật. Redirect URI phải khớp chính xác trong Meta App.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v25.0"
META_REDIRECT_URI="https://admin.30nice.vn/api/integrations/meta/callback"
META_WEBHOOK_VERIFY_TOKEN=""
# Tạo bằng: openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=""

# === NEXT.JS ===
NEXTAUTH_URL="https://admin.30nice.vn"
NODE_ENV="production"
# Phải khớp với nginx proxy_pass và PORT trong deploy/ecosystem.config.js.
PORT=3001

# === PROXY NỘI BỘ ===
# Edge proxy gọi /api/internal qua URL này để lấy redirect rule của từng tenant.
# Phải trỏ đúng cổng app đang lắng nghe, nếu sai thì redirect rule im lặng không chạy.
INTERNAL_BASE_URL="http://127.0.0.1:3001"
